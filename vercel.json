{
  "version": 2,
  "name": "sigerak-dashboard",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "frontend/api/index.py": {
      "runtime": "@vercel/python@3",
      "includeFiles": ["frontend/backend/**"]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/frontend/api/index.py"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/frontend/dist/index.html"
    }
  ]
}
